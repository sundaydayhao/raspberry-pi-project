[Unit]
Description=Canting Restaurant Display App
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/canting
Environment=NODE_ENV=production
EnvironmentFile=/home/pi/canting/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

